---
import MainLayout from '../layouts/MainLayout.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'contact');
const faqData = await getEntry('common', 'faq');
const { title, description, heroTitle, heroSubtitle, formNote, formFallback, responseTime, mapNote, ctaSection } = page.data;
const faqItems = faqData.data.items;
---

<MainLayout {title} {description}>
  <!-- Hero -->
  <section class="relative py-24 bg-deep/90">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center">
      <h1 class="text-5xl md:text-6xl font-display font-bold text-white mb-8">
        {heroTitle}
      </h1>
      <p class="text-xl text-white/80 max-w-3xl mx-auto">
        {heroSubtitle}
      </p>
    </div>
  </section>

  <section class="py-24">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
        <div class="glass-panel p-10">
          <h2 class="text-3xl font-display font-bold text-white mb-8">문의 폼</h2>
          <p class="text-white/70 mb-8">
            {formNote}
          </p>
          <div class="space-y-4">
            <div class="h-12 bg-white/5 rounded-lg"></div>
            <div class="h-12 bg-white/5 rounded-lg"></div>
            <div class="h-32 bg-white/5 rounded-lg"></div>
            <div class="h-12 bg-white/5 rounded-lg"></div>
          </div>
          <div class="mt-8 pt-8 border-t border-white/10">
            <p class="text-sm text-white/60">
              {formFallback}
            </p>
          </div>
        </div>

        <div class="space-y-10">
          <div class="glass-panel p-10">
            <h3 class="text-2xl font-bold text-white mb-6">연락처 정보</h3>
            <div class="space-y-4">
              <div>
                <div class="text-sm text-white/50">대표번호</div>
                <div class="text-xl font-bold text-white">1566-1931</div>
              </div>
              <div>
                <div class="text-sm text-white/50">이메일</div>
                <div class="text-xl font-bold text-white">contact@rowingpro.co.kr</div>
              </div>
              <div>
                <div class="text-sm text-white/50">주소</div>
                <div class="text-xl font-bold text-white">
                  경기도 하남시 덕풍동로 111-21, 케이앤몰동 10층 1021호
                </div>
              </div>
              <div>
                <div class="text-sm text-white/50">사업자등록번호</div>
                <div class="text-xl font-bold text-white">211-88-99912</div>
              </div>
              <div>
                <div class="text-sm text-white/50">법인등록번호</div>
                <div class="text-xl font-bold text-white">110111-5216282</div>
              </div>
            </div>
          </div>

          <div class="glass-panel p-10">
            <h3 class="text-2xl font-bold text-white mb-6">{responseTime.heading}</h3>
            <p class="text-white/70" set:html={responseTime.body.replace('\n', '<br>')} />
          </div>

          <div class="glass-panel p-10">
            <h3 class="text-2xl font-bold text-white mb-6">오시는 길</h3>
            <div class="h-48 rounded-2xl border border-white/10 bg-white/5 flex items-center justify-center text-white/60 text-sm">
              {mapNote}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 border-t border-white/10">
    <div class="max-w-5xl mx-auto px-6 lg:px-8">
      <h2 class="text-4xl font-display font-bold text-white mb-10 text-center">자주 묻는 질문</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {faqItems.map((item: { q: string; a: string }) => (
          <div class="glass-panel p-6">
            <h3 class="text-lg font-bold text-white mb-3">{item.q}</h3>
            <p class="text-white/70">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 bg-deep/50">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center">
      <h2 class="text-4xl font-display font-bold text-white mb-8">
        {ctaSection.heading}
      </h2>
      <p class="text-xl text-white/80 mb-12">
        {ctaSection.body}
      </p>
      <a href={ctaSection.href} class="btn-primary inline-flex items-center justify-center px-12 py-4 text-lg">
        {ctaSection.cta}
      </a>
    </div>
  </section>
</MainLayout>
