---
import ClientLogosBanner from '../components/ClientLogosBanner.astro';

const allLogoFiles = import.meta.glob('/public/assets/images/logos/*');
const logoUrls = Object.keys(allLogoFiles).map((path) => path.replace('/public', ''));
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>롤링배너 테스트</title>
    <style>
      body {
        background: #05080f;
        color: white;
        font-family: sans-serif;
        margin: 0;
        padding: 0;
      }
      .debug {
        padding: 1rem 2rem;
        background: #111;
        font-size: 0.85rem;
        color: #aaa;
      }
    </style>
  </head>
  <body>
    <div class="debug">
      롤링배너 테스트 페이지 | 로고 수: <strong style="color:#00F0FF">{logoUrls.length}개</strong>
      | <a href="/" style="color:#2C63A7">← 메인으로</a>
    </div>

    <ClientLogosBanner />

    <div class="debug" style="margin-top:2rem;">
      로고 URL 목록:
      <ul style="columns:3; font-size:0.75rem; color:#666;">
        {logoUrls.map(url => <li>{url}</li>)}
      </ul>
    </div>
  </body>
</html>
