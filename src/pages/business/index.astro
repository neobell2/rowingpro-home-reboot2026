---
import MainLayout from '../../layouts/MainLayout.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'business-hub');
const { title, description, heroTitle, heroSubtitle, cards, ctaSection } = page.data;
---

<MainLayout {title} {description}>
  <!-- Hero -->
  <section class="relative py-24 bg-deep/90">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center">
      <h1 class="text-5xl md:text-6xl font-display font-bold text-white mb-8">
        {heroTitle}
      </h1>
      <p class="text-xl text-white/80 max-w-3xl mx-auto">
        {heroSubtitle}
      </p>
    </div>
  </section>

  <!-- Service Categories -->
  <section class="py-24">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <h2 class="text-4xl font-display font-bold text-white mb-12 text-center">비즈니스 서비스</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {cards?.map((card: { title: string; description: string; href: string }) => (
          <a href={card.href} class="glass-panel p-8 hover:border-neon/40 transition-all group block">
            <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-neon">{card.title}</h3>
            <p class="text-white/70 mb-4">{card.description}</p>
            <span class="text-sm text-neon">바로가기 →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Guidance -->
  {ctaSection && (
    <section class="py-24 bg-deep/50">
      <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center">
        <h2 class="text-4xl font-display font-bold text-white mb-8">
          {ctaSection.heading}
        </h2>
        <p class="text-xl text-white/80 mb-12">
          {ctaSection.body}
        </p>
        <a href={ctaSection.href} class="btn-primary inline-flex items-center justify-center px-12 py-4 text-lg">
          {ctaSection.cta}
        </a>
      </div>
    </section>
  )}
</MainLayout>
