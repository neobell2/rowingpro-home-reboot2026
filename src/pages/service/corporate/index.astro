---
import MainLayout from '../../../layouts/MainLayout.astro';

const corporateServices = [
  {
    href: '/service/corporate/training',
    title: 'Training',
    description: '신입교육·조직개발 목적의 HRD 적용형 프로그램',
  },
  {
    href: '/service/corporate/teambuilding',
    title: 'Teambuilding',
    description: '협업 구조를 체감하는 현장형 팀빌딩 과정',
  },
  {
    href: '/service/corporate/leadership',
    title: 'Leadership',
    description: '리더·팔로워 역할 전환 중심의 리더십 강화',
  },
  {
    href: '/service/corporate/event',
    title: 'Event',
    description: '기념행사·단합행사에 맞춘 운영형 솔루션',
  },
  {
    href: '/service/corporate/wellness',
    title: 'Wellness',
    description: '임직원 웰빙 중심의 활동형 건강 프로그램',
  },
];
---

<MainLayout title="Corporate Service Hub | 로잉프로" description="기업·조직 맞춤형 조정 프로그램 허브">
  <section class="relative py-24 bg-deep/90">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center">
      <h1 class="text-5xl md:text-6xl font-display font-bold text-white mb-8">Corporate Service Hub</h1>
      <p class="text-xl text-white/80 max-w-3xl mx-auto">
        기업·조직 대상 프로그램은 HRD 적용형과 비HRD 행사형으로 나누어 설계합니다.
      </p>
    </div>
  </section>

  <section class="py-24">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {corporateServices.map((service) => (
          <a href={service.href} class="glass-panel p-8 hover:border-heritage/60 transition-all block">
            <h2 class="text-2xl font-bold text-white mb-3">{service.title}</h2>
            <p class="text-white/70 mb-4">{service.description}</p>
            <span class="text-neon text-sm">상세 보기 →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</MainLayout>
