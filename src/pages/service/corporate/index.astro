---
import MainLayout from '../../../layouts/MainLayout.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'service-corporate-hub');
const { title, description, heroTitle, heroSubtitle, services } = page.data;
---

<MainLayout {title} {description}>
  <section class="relative py-24 bg-deep/90">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center">
      <h1 class="text-5xl md:text-6xl font-display font-bold text-white mb-8">{heroTitle}</h1>
      <p class="text-xl text-white/80 max-w-3xl mx-auto">
        {heroSubtitle}
      </p>
    </div>
  </section>

  <section class="py-24">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {services.map((service: { href: string; title: string; description: string }) => (
          <a href={service.href} class="glass-panel p-8 hover:border-heritage/60 transition-all block">
            <h2 class="text-2xl font-bold text-white mb-3">{service.title}</h2>
            <p class="text-white/70 mb-4">{service.description}</p>
            <span class="text-neon text-sm">상세 보기 →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</MainLayout>
