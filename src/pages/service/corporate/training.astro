---
import ServiceDetailPage from '../../../components/ServiceDetailPage.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'service-corporate-training');
const { title, description, summary, bullets, audience, ctaLabel } = page.data;
---

<ServiceDetailPage
  title="Corporate Training"
  {description}
  {summary}
  {bullets}
  {audience}
  {ctaLabel}
/>
