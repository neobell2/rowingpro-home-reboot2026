---
import ServiceDetailPage from '../../components/ServiceDetailPage.astro';

const bullets = [
  '정기 레슨 기반의 생활체육형 조정 프로그램 운영',
  '동호회 목표(기초, 기록 향상, 대회 준비)에 따른 레벨 분반',
  '원데이 체험부터 장기 훈련까지 유연한 참여 방식 제공',
];
---

<ServiceDetailPage
  title="Club & General"
  description="클럽 및 일반인 대상 조정 프로그램"
  summary="정기 레슨과 동호회 활동 중심으로 운영되는 클럽·일반 대상 프로그램입니다."
  bullets={bullets}
  audience="성인 입문자, 생활체육 동호회, 마스터즈 대회 준비 팀"
  footnote="수상 훈련은 수온과 풍속, 현장 안전 조건에 따라 실내 세션으로 대체될 수 있습니다."
  ctaLabel="참가 신청 문의"
/>
