---
import ServiceDetailPage from '../../components/ServiceDetailPage.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'life-sports-event');
const { title, description, summary, bullets, audience, ctaLabel, packageSection } = page.data;
---

<ServiceDetailPage
  title="Sports Event"
  {description}
  {summary}
  {bullets}
  {audience}
  {ctaLabel}
>
  <section class="pb-24">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="glass-panel p-10">
        <h2 class="text-3xl font-display font-bold text-white mb-8">{packageSection.heading}</h2>
        <p class="text-white/70 mb-8">{packageSection.note}</p>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {packageSection.tiers.map((tier: { id: string; label: string; note?: string; price?: string; priceNote?: string; specs?: string[]; featured: boolean }) => (
            <div class={tier.featured ? "bg-heritage/10 p-6 rounded-2xl border border-heritage/50" : "bg-white/5 p-6 rounded-2xl border border-white/10"}>
              <h3 class={`text-xl font-bold mb-2 ${tier.featured ? 'text-heritage' : 'text-white'}`}>{tier.id}</h3>
              {tier.price ? (
                <>
                  <p class="text-3xl font-bold text-white mb-4">
                    {tier.price} <span class="text-base font-normal text-white/60">{tier.priceNote}</span>
                  </p>
                  <ul class="space-y-2 text-white/75 text-sm">
                    {tier.specs?.map((spec: string) => (
                      <li>• {spec}</li>
                    ))}
                  </ul>
                </>
              ) : (
                <>
                  <p class="text-white/80 mb-3">{tier.label}</p>
                  <p class="text-sm text-white/60">{tier.note}</p>
                </>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</ServiceDetailPage>
