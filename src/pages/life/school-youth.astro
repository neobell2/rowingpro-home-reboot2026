---
import ServiceDetailPage from '../../components/ServiceDetailPage.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'life-school-youth');
const { title, description, summary, bullets, audience, footnote, ctaLabel } = page.data;
---

<ServiceDetailPage
  title="School & Youth"
  {description}
  {summary}
  {bullets}
  {audience}
  {footnote}
  {ctaLabel}
/>
