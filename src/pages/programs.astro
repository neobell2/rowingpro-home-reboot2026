---
import MainLayout from '../layouts/MainLayout.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'programs');
const { title, description, heroTitle, heroSubtitle, cards, footnote, ctaSection } = page.data;
---

<MainLayout {title} {description}>
  <!-- Hero -->
  <section class="relative py-24 bg-deep/90">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center">
      <h1 class="text-5xl md:text-6xl font-display font-bold text-white mb-8">{heroTitle}</h1>
      <p class="text-xl text-white/80 max-w-3xl mx-auto">
        {heroSubtitle}
      </p>
    </div>
  </section>

  <section class="py-24">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {cards.map((card: { title: string; description: string; points: string[] }) => (
          <div class="glass-panel p-10">
            <h2 class="text-2xl font-bold text-white mb-4">{card.title}</h2>
            <p class="text-white/75 mb-6">{card.description}</p>
            <ul class="space-y-2 text-white/65 text-sm">
              {card.points.map((point: string) => (
                <li>• {point}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="text-white/55 text-sm mt-8">
        {footnote}
      </p>
    </div>
  </section>

  <section class="py-24 bg-deep/50">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center">
      <h2 class="text-4xl font-display font-bold text-white mb-8">{ctaSection.heading}</h2>
      <p class="text-xl text-white/80 mb-12">
        {ctaSection.body}
      </p>
      <a href={ctaSection.href} class="btn-primary inline-flex items-center justify-center px-12 py-4 text-lg">
        {ctaSection.cta}
      </a>
    </div>
  </section>
</MainLayout>
