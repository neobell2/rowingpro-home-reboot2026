---
import MainLayout from '../layouts/MainLayout.astro';

const title = 'Programs | 로잉프로';
const description = '전체 프로그램 개요/분류: 인도어, 아웃도어, 워크숍 프로그램 안내';

const programCards = [
  {
    title: '인도어 프로그램',
    description: '실내 에르고미터 중심 기초 및 팀워크 훈련',
    points: ['기초 동작 습득', '팀 리듬 훈련', '날씨 영향 최소화'],
  },
  {
    title: '아웃도어 프로그램',
    description: '실제 보트 탑승, 수상 실습 중심 프로그램',
    points: ['실전 협업 경험', '코치 동승 운영', '현장 몰입도 강화'],
  },
  {
    title: '체험형 부스 프로그램',
    description: '행사·축제용 퀵 체험 패키지',
    points: ['대규모 체험 대응', '운영 인력 포함', '기록 이벤트 연동'],
  },
  {
    title: 'MIX 프로그램',
    description: '실내외 병행 순환식 교육',
    points: ['이론+실습 연계', '난이도 단계 조절', '조직 목적 맞춤 설계'],
  },
];
---

<MainLayout {title} {description}>
  <!-- Hero -->
  <section class="relative py-24 bg-deep/90">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center">
      <h1 class="text-5xl md:text-6xl font-display font-bold text-white mb-8">전체 프로그램 개요</h1>
      <p class="text-xl text-white/80 max-w-3xl mx-auto">
        Programs 페이지는 전체 분류를 안내하며, 상세 구성은 Service 페이지에서 확인하실 수 있습니다.
      </p>
    </div>
  </section>

  <section class="py-24">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {programCards.map((card) => (
          <div class="glass-panel p-10">
            <h2 class="text-2xl font-bold text-white mb-4">{card.title}</h2>
            <p class="text-white/75 mb-6">{card.description}</p>
            <ul class="space-y-2 text-white/65 text-sm">
              {card.points.map((point) => (
                <li>• {point}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="text-white/55 text-sm mt-8">
        세부 커리큘럼, 회차, 인원 구성은 조직 목적과 현장 조건에 맞춰 맞춤 제안드립니다.
      </p>
    </div>
  </section>

  <section class="py-24 bg-deep/50">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center">
      <h2 class="text-4xl font-display font-bold text-white mb-8">상세 서비스 보기</h2>
      <p class="text-xl text-white/80 mb-12">
        각 프로그램의 상세 내용은 Service 페이지에서 확인하실 수 있습니다.
      </p>
      <a href="/service" class="btn-primary inline-flex items-center justify-center px-12 py-4 text-lg">
        Service 바로가기
      </a>
    </div>
  </section>
</MainLayout>
