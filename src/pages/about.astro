---
import MainLayout from '../layouts/MainLayout.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'about');
const { title, description, heroTitle, heroSubtitle, translationSection, differentiators, founders, coreMessage } = page.data;
---

<MainLayout {title} {description}>
  <section class="relative py-24 bg-deep/90">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center">
      <h1 class="text-5xl md:text-6xl font-display font-bold text-white mb-8">
        {heroTitle}
      </h1>
      <p class="text-xl text-white/80 max-w-3xl mx-auto">
        {heroSubtitle}
      </p>
    </div>
  </section>

  <section class="py-24">
    <div class="max-w-5xl mx-auto px-6 lg:px-8">
      <div class="glass-panel p-10">
        <h2 class="text-3xl font-display font-bold text-white mb-6">{translationSection.heading}</h2>
        <p class="text-white/80 text-lg mb-6">
          {translationSection.body}
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {translationSection.pillars.map((pillar: { title: string; detail: string }) => (
            <div class="bg-white/5 border border-white/10 rounded-2xl p-6">
              <h3 class="text-xl font-bold text-heritage mb-2">{pillar.title}</h3>
              <p class="text-white/70">{pillar.detail}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-deep/40">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <h2 class="text-4xl font-display font-bold text-white mb-10 text-center">{differentiators.heading}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {differentiators.items.map((item: { value: string; detail: string }) => (
          <div class="glass-panel p-8 text-center">
            <div class="text-5xl font-display font-bold text-heritage mb-4">{item.value}</div>
            <p class="text-white/80">{item.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 bg-deep/50">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <h2 class="text-4xl font-display font-bold text-white mb-12 text-center">{founders.heading}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        {founders.items.map((founder: { name: string; bio: string; period: string }) => (
          <div class="glass-panel p-10">
            <h3 class="text-2xl font-bold text-white mb-4">{founder.name}</h3>
            <p class="text-white/80 mb-6">
              {founder.bio}
            </p>
            <div class="text-sm text-white/60">{founder.period}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center">
      <h2 class="text-4xl font-display font-bold text-white mb-8">{coreMessage.heading}</h2>
      <p class="text-xl text-white/80 leading-relaxed">
        {coreMessage.body}
      </p>
    </div>
  </section>
</MainLayout>
