---
import MainLayout from '../layouts/MainLayout.astro';

const title = 'History | 로잉프로';
const description = '13년 업력 전수 기록, 걸어온 길';

const timeline = [
  {
    year: '2024-2025',
    title: '현장의 리더',
    details: [
      '기업/기관: ABL생명, 서울특별시(한강 쉬엄쉬엄 3종 축제), 하남시조정협회 수상안전교육',
      '대회 운영: 하남시장배, 하남시조정협회장배, 용인시장배',
    ],
  },
  {
    year: '2023',
    title: '화려한 복귀 (Re-boot)',
    details: [
      '기업: 힐티코리아, 한국머스크, 애경그룹, 울산의대, 가천대의대',
      '학교/교육: 다산중학교, 은가람중학교, 한대부고, 경기이룸학교',
      '커뮤니티: 아마추어로잉 아카데미 런칭',
    ],
  },
  {
    year: '2019-2022',
    title: '확장과 인내',
    details: [
      '기업: 금호석유화학, 연합뉴스, 세방그룹, 한국벤처투자, 현대자동차 티움',
      '이벤트: 한강 올림픽데이런, 광명스피돔 두바퀴축제, 부산광역시장배',
      '글로벌: 플로리다 사라소타(World Rowing) 프로젝트 수행',
    ],
  },
  {
    year: '2016-2018',
    title: '성장의 정점',
    details: [
      '현대자동차, LG디스플레이, 구찌코리아, 삼성웰스토리 등 다수 파트너십',
      '공공: 강동구청, 지역난방공사, 건강관리협회 등 협업 확대',
    ],
  },
  {
    year: '2013-2015',
    title: '위대한 시작 (The Origin)',
    details: [
      '메트라이프, 롯데카드, SK브로드밴드, 삼성전자 등 런칭 실적 확보',
      '2013년 국내 최초 기업 조정 도입',
      '경기국제보트쇼, 전국체전 운영 및 대학 조정부 훈련 시스템 지원',
    ],
  },
];
---

<MainLayout {title} {description}>
  <section class="relative py-24 bg-deep/90">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center">
      <h1 class="text-5xl md:text-6xl font-display font-bold text-white mb-8">THE ORIGIN OF CORPORATE ROWING</h1>
      <p class="text-xl text-white/80 max-w-3xl mx-auto">
        대한민국 기업 조정 교육의 시작과 현재, 13년의 독보적인 기록입니다.
      </p>
    </div>
  </section>

  <section class="py-24">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <div class="space-y-12">
        {timeline.map((item) => (
          <div class="glass-panel p-10">
            <div class="flex items-center mb-6">
              <div class="text-4xl md:text-5xl font-display font-bold text-heritage mr-6">{item.year}</div>
              <div class="h-0.5 flex-1 bg-white/20"></div>
            </div>
            <h3 class="text-2xl font-bold text-white mb-4">{item.title}</h3>
            <ul class="text-white/70 space-y-2">
              {item.details.map((detail) => (
                <li>• {detail}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 bg-deep/50">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <h2 class="text-4xl font-display font-bold text-white mb-12 text-center">13년의 숫자</h2>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        <div class="text-center">
          <div class="text-5xl font-display font-bold text-heritage mb-4">13+</div>
          <p class="text-white/80">Years</p>
        </div>
        <div class="text-center">
          <div class="text-5xl font-display font-bold text-heritage mb-4">0</div>
          <p class="text-white/80">Zero Accident</p>
        </div>
        <div class="text-center">
          <div class="text-5xl font-display font-bold text-heritage mb-4">150+</div>
          <p class="text-white/80">Clients</p>
        </div>
        <div class="text-center">
          <div class="text-5xl font-display font-bold text-heritage mb-4">10,000+</div>
          <p class="text-white/80">Participants</p>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
