---
import MainLayout from '../layouts/MainLayout.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'history');
const { title, description, heroTitle, heroSubtitle, timeline, stats } = page.data;
---

<MainLayout {title} {description}>
  <section class="relative py-24 bg-deep/90">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center">
      <h1 class="text-5xl md:text-6xl font-display font-bold text-white mb-8">{heroTitle}</h1>
      <p class="text-xl text-white/80 max-w-3xl mx-auto">
        {heroSubtitle}
      </p>
    </div>
  </section>

  <section class="py-24">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <div class="space-y-12">
        {timeline.map((item: { year: string; title: string; details: string[] }) => (
          <div class="glass-panel p-10">
            <div class="flex items-center mb-6">
              <div class="text-4xl md:text-5xl font-display font-bold text-heritage mr-6">{item.year}</div>
              <div class="h-0.5 flex-1 bg-white/20"></div>
            </div>
            <h3 class="text-2xl font-bold text-white mb-4">{item.title}</h3>
            <ul class="text-white/70 space-y-2">
              {item.details.map((detail: string) => (
                <li>• {detail}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 bg-deep/50">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <h2 class="text-4xl font-display font-bold text-white mb-12 text-center">{stats.heading}</h2>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        {stats.items.map((stat: { value: string; label: string }) => (
          <div class="text-center">
            <div class="text-5xl font-display font-bold text-heritage mb-4">{stat.value}</div>
            <p class="text-white/80">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</MainLayout>
