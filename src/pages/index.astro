---
import MainLayout from '../layouts/MainLayout.astro';
import ClientLogosBanner from '../components/ClientLogosBanner.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'index');
const { title, description, heroTitle, heroSubtitle, ctaPrimary, ctaSecondary, stats, ctaSection } = page.data;
---

<MainLayout {title} {description}>
  <!-- Hero Section with Video Background -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden">
    <!-- Video Background -->
    <div class="absolute inset-0 z-0">
      <video autoplay muted loop playsinline class="w-full h-full object-cover opacity-90">
        <source src="/videos/hero-bg.webm" type="video/webm">
        <source src="/videos/hero-bg.mp4" type="video/mp4">
      </video>
      <div class="absolute inset-0 bg-gradient-to-b from-deep/60 via-deep/40 to-deep/80"></div>
    </div>

    <!-- Hero Content -->
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 text-center">
      <h1 class="text-5xl md:text-7xl lg:text-8xl font-display font-bold text-white mb-8 leading-tight">
        {heroTitle}
      </h1>
      <p class="text-xl md:text-2xl text-white/80 mb-12 max-w-3xl mx-auto" style="white-space: pre-line;">
        {heroSubtitle}
      </p>
      <div class="flex flex-col sm:flex-row gap-6 justify-center">
        <a href="#services" class="btn-primary inline-flex items-center justify-center">
          {ctaPrimary}
        </a>
        <a href="/contact" class="btn-secondary inline-flex items-center justify-center">
          {ctaSecondary}
        </a>
      </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10">
      <div class="animate-bounce">
        <svg class="w-8 h-8 text-white/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </div>
    </div>
  </section>

  <!-- Client Logos Rolling Banner -->
  <ClientLogosBanner />

  <!-- Stats Section -->
  <section class="py-24 bg-deep/90">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
        {stats.map((stat: { value: string; label: string; detail: string }) => (
          <div class="glass-panel p-8 text-center">
            <div class="text-6xl font-display font-bold text-heritage mb-4">{stat.value}</div>
            <h3 class="text-xl font-bold text-white mb-2">{stat.label}</h3>
            <p class="text-white/70">{stat.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Delivery Methods Section -->
  <section class="py-24">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <h2 class="text-4xl font-display font-bold text-white mb-12 text-center">제공 방식</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="glass-panel p-6 text-center">
          <h3 class="text-xl font-bold text-white mb-2">인도어 로잉</h3>
          <p class="text-white/70">실내 액티비티</p>
        </div>
        <div class="glass-panel p-6 text-center">
          <h3 class="text-xl font-bold text-white mb-2">수상 로잉</h3>
          <p class="text-white/70">야외 액티비티</p>
        </div>
        <div class="glass-panel p-6 text-center">
          <h3 class="text-xl font-bold text-white mb-2">부스형</h3>
          <p class="text-white/70">행사 맞춤형</p>
        </div>
        <div class="glass-panel p-6 text-center">
          <h3 class="text-xl font-bold text-white mb-2">MIX</h3>
          <p class="text-white/70">인도어 + 수상</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Preview Section -->
  <section id="services" class="py-24 bg-deep/50">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <h2 class="text-4xl font-display font-bold text-white mb-12 text-center">서비스 미리보기</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <a href="/business" class="glass-panel p-8 hover:border-neon/40 transition-all group block">
          <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-neon">비즈니스 (Business)</h3>
          <p class="text-white/70 mb-4">기업, 조직, 단체를 위한 HRD 및 프로모션</p>
          <span class="text-sm text-neon">자세히 보기 →</span>
        </a>
        <a href="/life" class="glass-panel p-8 hover:border-neon/40 transition-all group block">
          <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-neon">라이프 (Life)</h3>
          <p class="text-white/70 mb-4">학교, 청소년, 가족, 동호회를 위한 교육 및 체험</p>
          <span class="text-sm text-neon">자세히 보기 →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Why RowingPro Section -->
  <section class="py-24">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <h2 class="text-4xl font-display font-bold text-white mb-12 text-center">왜 로잉프로인가</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="glass-panel p-6">
          <h3 class="text-lg font-bold text-white mb-2 text-neon">01</h3>
          <h4 class="text-xl font-bold text-white mb-3">전문성</h4>
          <p class="text-white/70">조정 전문가 회사</p>
        </div>
        <div class="glass-panel p-6">
          <h3 class="text-lg font-bold text-white mb-2 text-neon">02</h3>
          <h4 class="text-xl font-bold text-white mb-3">리얼 팀워크</h4>
          <p class="text-white/70">진정한 호흡의 경험</p>
        </div>
        <div class="glass-panel p-6">
          <h3 class="text-lg font-bold text-white mb-2 text-neon">03</h3>
          <h4 class="text-xl font-bold text-white mb-3">맞춤형 설계</h4>
          <p class="text-white/70">고객 목적 기반 커리큘럼</p>
        </div>
        <div class="glass-panel p-6">
          <h3 class="text-lg font-bold text-white mb-2 text-neon">04</h3>
          <h4 class="text-xl font-bold text-white mb-3">검증된 결과</h4>
          <p class="text-white/70">무사고 13년 3만명 고객</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  {ctaSection && (
    <section class="py-24">
      <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center">
        <h2 class="text-4xl md:text-5xl font-display font-bold text-white mb-8">
          {ctaSection.heading}
        </h2>
        <p class="text-xl text-white/80 mb-12">
          {ctaSection.body}
        </p>
        <a href="/contact" class="btn-primary inline-flex items-center justify-center px-12 py-4 text-lg">
          {ctaSection.cta}
        </a>
      </div>
    </section>
  )}
</MainLayout>
