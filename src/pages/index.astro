---
import MainLayout from '../layouts/MainLayout.astro';

const title = 'ROWING PRO | The Kinetic Experience';
const description = '대한민국 국가대표 출신이 운영하는 HRD/팀빌딩 전문 기업';
---

<MainLayout {title} {description}>
  <!-- Hero Section with Video Background -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden">
    <!-- Video Background -->
    <div class="absolute inset-0 z-0">
      <video autoplay muted loop playsinline class="w-full h-full object-cover opacity-90">
        <source src="/videos/hero-bg.webm" type="video/webm">
        <source src="/videos/hero-bg.mp4" type="video/mp4">
      </video>
      <div class="absolute inset-0 bg-gradient-to-b from-deep/60 via-deep/40 to-deep/80"></div>
    </div>

    <!-- Hero Content -->
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 text-center">
      <h1 class="text-5xl md:text-7xl lg:text-8xl font-display font-bold text-white mb-8 leading-tight">
        ROWING = TEAMWORK
      </h1>
      <p class="text-xl md:text-2xl text-white/80 mb-12 max-w-3xl mx-auto">
        대한민국 국가대표 출신이 운영하는 HRD/팀빌딩 전문 기업
      </p>
      <div class="flex flex-col sm:flex-row gap-6 justify-center">
        <a href="/service" class="btn-primary inline-flex items-center justify-center">
          서비스 살펴보기
        </a>
        <a href="/contact" class="btn-secondary inline-flex items-center justify-center">
          문의하기
        </a>
      </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10">
      <div class="animate-bounce">
        <svg class="w-8 h-8 text-white/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="py-24 bg-deep/90">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
        <!-- Stat 1 -->
        <div class="glass-panel p-8 text-center">
          <div class="text-6xl font-display font-bold text-heritage mb-4">100%</div>
          <h3 class="text-xl font-bold text-white mb-2">선수 출신만 채용</h3>
          <p class="text-white/70">스탭·알바 포함 전원 조정 선수 출신</p>
        </div>
        <!-- Stat 2 -->
        <div class="glass-panel p-8 text-center">
          <div class="text-6xl font-display font-bold text-heritage mb-4">13<span class="text-3xl">년</span></div>
          <h3 class="text-xl font-bold text-white mb-2">13년 무사고</h3>
          <p class="text-white/70">2013년부터 단 한 건의 사고 없이</p>
        </div>
        <!-- Stat 3 -->
        <div class="glass-panel p-8 text-center">
          <div class="text-6xl font-display font-bold text-heritage mb-4">1:1</div>
          <h3 class="text-xl font-bold text-white mb-2">1보트 1코치 탑승</h3>
          <p class="text-white/70">모든 보트에 코치가 직접 탑승</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-24">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center">
      <h2 class="text-4xl md:text-5xl font-display font-bold text-white mb-8">
        최고의 조정 경험을 시작하세요
      </h2>
      <p class="text-xl text-white/80 mb-12">
        기업 교육, 학교 프로그램, 스포츠 이벤트까지 다양한 프로그램을 제공합니다.
      </p>
      <a href="/contact" class="btn-primary inline-flex items-center justify-center px-12 py-4 text-lg">
        지금 문의하기
      </a>
    </div>
  </section>
</MainLayout>
