---
import MainLayout from '../layouts/MainLayout.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'privacy');
const { title, description, heroTitle, lastModified, sections } = page.data;
---

<MainLayout {title} {description}>
  <section class="relative py-24 bg-deep/90">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-display font-bold text-white mb-8">{heroTitle}</h1>
      <p class="text-lg text-white/80">최종 수정일: {lastModified}</p>
    </div>
  </section>

  <section class="py-24">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <div class="glass-panel p-10 space-y-8 text-white/80">
        {sections.map((section: { heading: string; body: string; bullets?: string[]; contact?: { name: string; position: string; phone: string; email: string } }) => (
          <div>
            <h2 class="text-2xl font-bold text-white mb-4">{section.heading}</h2>
            <p>{section.body}</p>
            {section.bullets && (
              <ul class="list-disc pl-5 mt-2 space-y-1">
                {section.bullets.map((bullet: string) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            )}
            {section.contact && (
              <div class="mt-4 bg-white/5 p-4 rounded-lg">
                <p>성명: {section.contact.name}</p>
                <p>직책: {section.contact.position}</p>
                <p>연락처: {section.contact.phone}, {section.contact.email}</p>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
</MainLayout>
