---
import MainLayout from '../layouts/MainLayout.astro';

interface Props {
  title: string;
  description: string;
  summary: string;
  bullets: string[];
  audience?: string;
  footnote?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  title,
  description,
  summary,
  bullets,
  audience,
  footnote,
  ctaLabel = '문의하기',
  ctaHref = '/contact',
} = Astro.props;
---

<MainLayout title={`${title} | 로잉프로`} {description}>
  <section class="relative py-24 bg-deep/90">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center">
      <h1 class="text-5xl md:text-6xl font-display font-bold text-white mb-8">{title}</h1>
      <p class="text-xl text-white/80 max-w-3xl mx-auto">{summary}</p>
    </div>
  </section>

  <section class="py-24">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <div class="glass-panel p-10">
        <h2 class="text-3xl font-display font-bold text-white mb-8">프로그램 개요</h2>
        <ul class="space-y-4 text-white/75">
          {bullets.map((bullet) => (
            <li>• {bullet}</li>
          ))}
        </ul>
        {audience && (
          <div class="mt-8 pt-8 border-t border-white/10">
            <h3 class="text-lg font-bold text-white mb-2">권장 대상</h3>
            <p class="text-white/70">{audience}</p>
          </div>
        )}
        {footnote && <p class="mt-8 text-sm text-white/60">{footnote}</p>}
      </div>
    </div>
  </section>

  <slot />

  <section class="py-24 bg-deep/50">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center">
      <h2 class="text-4xl font-display font-bold text-white mb-8">맞춤형 프로그램 상담</h2>
      <a href={ctaHref} class="btn-primary inline-flex items-center justify-center px-12 py-4 text-lg">
        {ctaLabel}
      </a>
    </div>
  </section>
</MainLayout>
