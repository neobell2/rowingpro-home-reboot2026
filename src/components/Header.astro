---
// Header Component - Design System 적용
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: '비즈니스', href: '/business' },
  { label: '라이프', href: '/life' },
  { label: 'History', href: '/history' },
  { label: 'Contact', href: '/contact' },
];

const isActiveRoute = (href: string) => {
  if (href === '/') {
    return currentPath === '/';
  }

  return currentPath === href || currentPath.startsWith(`${href}/`);
};

const desktopLinkClasses = (href: string) => {
  const base = 'px-4 py-2 rounded-lg transition-colors duration-300 font-bold text-sm uppercase tracking-wide';

  if (isActiveRoute(href)) {
    return `${base} text-white bg-white/10 border border-white/20`;
  }

  return `${base} text-white/80 hover:text-white hover:bg-white/5`;
};

const desktopContactClasses = (href: string) => {
  const base = 'ml-4 btn-primary !px-8 !py-3 text-sm uppercase tracking-wide';

  if (isActiveRoute(href)) {
    return `${base} !bg-heritage/15 !border-heritage/80`;
  }

  return base;
};

const mobileLinkClasses = (href: string) => {
  const base = 'block rounded-xl px-4 py-3 text-base font-bold uppercase tracking-wide transition-colors duration-300';

  if (href === '/contact') {
    if (isActiveRoute(href)) {
      return `${base} bg-heritage/20 border border-heritage/80 text-white`;
    }

    return `${base} btn-primary !px-4 !py-3 text-center`;
  }

  if (isActiveRoute(href)) {
    return `${base} bg-white/10 border border-white/20 text-white`;
  }

  return `${base} text-white/80 hover:text-white hover:bg-white/5`;
};
---

<header class="bg-deep/95 backdrop-blur-lg border-b border-white/10 fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <nav class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      <!-- Logo -->
      <div class="flex-shrink-0">
        <a href="/" class="hover:opacity-80 transition-opacity duration-300">
          <img src="/logo.svg" alt="로잉프로" class="h-12 w-auto" />
        </a>
      </div>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center space-x-2">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={item.href === '/contact' ? desktopContactClasses(item.href) : desktopLinkClasses(item.href)}
            aria-current={isActiveRoute(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
      </div>

      <!-- Mobile menu button -->
      <div class="md:hidden">
        <button
          type="button"
          class="text-white hover:text-neon transition-colors duration-300 p-2"
          data-mobile-menu-button
          aria-controls="mobile-menu-panel"
          aria-expanded="false"
          aria-label="Toggle navigation menu"
        >
          <svg class="h-6 w-6" data-icon-open fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="h-6 w-6 hidden" data-icon-close fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </nav>

  <div
    class="fixed inset-0 z-[60] bg-deep/80 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"
    data-mobile-menu-overlay
  >
    <div
      id="mobile-menu-panel"
      class="glass-panel fixed right-0 top-0 h-full w-[85vw] max-w-sm rounded-none rounded-l-3xl border-l border-white/10 bg-deep/90 p-6 transform translate-x-full transition-transform duration-300"
      role="dialog"
      aria-modal="true"
      aria-label="Mobile Navigation"
      data-mobile-menu-panel
    >
      <div class="flex items-center justify-between">
        <span class="text-white font-display font-semibold text-xl uppercase tracking-wide">Menu</span>
        <button
          type="button"
          class="p-2 text-white/80 hover:text-white transition-colors duration-300"
          data-mobile-menu-close
          aria-label="Close navigation menu"
        >
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div class="mt-8 flex flex-col gap-2">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={mobileLinkClasses(item.href)}
            aria-current={isActiveRoute(item.href) ? 'page' : undefined}
            data-mobile-menu-link
          >
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</header>

<script>
  const mobileMenuButton = document.querySelector('[data-mobile-menu-button]');
  const mobileMenuOverlay = document.querySelector('[data-mobile-menu-overlay]');
  const mobileMenuPanel = document.querySelector('[data-mobile-menu-panel]');
  const mobileMenuCloseButton = document.querySelector('[data-mobile-menu-close]');
  const mobileMenuLinks = document.querySelectorAll('[data-mobile-menu-link]');

  if (mobileMenuButton && mobileMenuOverlay && mobileMenuPanel && mobileMenuCloseButton) {
    const openIcon = mobileMenuButton.querySelector('[data-icon-open]');
    const closeIcon = mobileMenuButton.querySelector('[data-icon-close]');

    const isMenuOpen = () => mobileMenuButton.getAttribute('aria-expanded') === 'true';
    // @ts-ignore
    const isClickOutsidePanel = (target) => {
      if (!(target instanceof Node)) {
        return false;
      }

      return !mobileMenuPanel.contains(target) && !mobileMenuButton.contains(target);
    };

    // @ts-ignore
    const setMenuState = (open) => {
      mobileMenuButton.setAttribute('aria-expanded', open ? 'true' : 'false');
      mobileMenuOverlay.classList.toggle('opacity-0', !open);
      mobileMenuOverlay.classList.toggle('pointer-events-none', !open);
      mobileMenuPanel.classList.toggle('translate-x-full', !open);
      document.body.classList.toggle('overflow-hidden', open);

      if (openIcon && closeIcon) {
        openIcon.classList.toggle('hidden', open);
        closeIcon.classList.toggle('hidden', !open);
      }
    };

    mobileMenuButton.addEventListener('click', () => {
      setMenuState(!isMenuOpen());
    });

    mobileMenuCloseButton.addEventListener('click', () => {
      setMenuState(false);
    });

    mobileMenuLinks.forEach((link) => {
      link.addEventListener('click', () => {
        setMenuState(false);
      });
    });

    mobileMenuOverlay.addEventListener('click', (event) => {
      if (event.target === mobileMenuOverlay) {
        setMenuState(false);
      }
    });

    document.addEventListener('pointerdown', (event) => {
      if (isMenuOpen() && isClickOutsidePanel(event.target)) {
        setMenuState(false);
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        setMenuState(false);
      }
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768) {
        setMenuState(false);
      }
    });
  }
</script>
