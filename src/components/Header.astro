---
// Header Component - Design System 적용
---

<header class="bg-deep/95 backdrop-blur-lg border-b border-white/10 fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <nav class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      <!-- Logo -->
      <div class="flex-shrink-0">
        <a href="/" class="hover:opacity-80 transition-opacity duration-300">
          <img src="/logo.svg" alt="로잉프로" class="h-12 w-auto" />
        </a>
      </div>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center space-x-2">
        <a href="/" class="text-white/80 hover:text-white px-4 py-2 transition-colors duration-300 font-bold text-sm uppercase tracking-wide hover:bg-white/5 rounded-lg">Home</a>
        <a href="/about" class="text-white/80 hover:text-white px-4 py-2 transition-colors duration-300 font-bold text-sm uppercase tracking-wide hover:bg-white/5 rounded-lg">About</a>
        <a href="/programs" class="text-white/80 hover:text-white px-4 py-2 transition-colors duration-300 font-bold text-sm uppercase tracking-wide hover:bg-white/5 rounded-lg">Programs</a>
        <a href="/service" class="text-white/80 hover:text-white px-4 py-2 transition-colors duration-300 font-bold text-sm uppercase tracking-wide hover:bg-white/5 rounded-lg">Service</a>
        <a href="/history" class="text-white/80 hover:text-white px-4 py-2 transition-colors duration-300 font-bold text-sm uppercase tracking-wide hover:bg-white/5 rounded-lg">History</a>
        <a href="/contact" class="ml-4 btn-primary !px-8 !py-3 text-sm uppercase tracking-wide">Contact</a>
      </div>

      <!-- Mobile menu button -->
      <div class="md:hidden">
        <button type="button" class="text-white hover:text-neon transition-colors duration-300 p-2">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </nav>
</header>
